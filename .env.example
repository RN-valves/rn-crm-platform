# ==============================================================================
# RN VALVES & FAUCETS – WHATSAPP CRM & AI AUTOMATION PLATFORM (.env.example)
# Copy this file to .env and configure with verified credentials
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ==============================================================================

# Server & Network Configuration
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://crm.rnvalves.com
BACKEND_URL=https://crm-api.rnvalves.com
JWT_SECRET=replace_with_a_secure_random_64_char_string
JWT_EXPIRES_IN=7d

# Existing MongoDB Databases
# 1. Writeable Logical Database for CRM Entities (leads, contacts, audit logs)
CRM_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rn-crm?retryWrites=true&w=majority
# 2. Strict Read-Only Access to Existing E-commerce Database (Product catalog & categories)
ECOMM_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rn-valves?retryWrites=true&w=majority

# Redis & BullMQ Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_redis_password
REDIS_DB=0

# Existing Evolution API v2.3.7 Settings
EVOLUTION_API_URL=https://wa-api.rnvalves.com
EVOLUTION_API_KEY=replace_with_evolution_global_api_key
EVOLUTION_INSTANCE_NAME=RNchat
EVOLUTION_WEBHOOK_SECRET=replace_with_webhook_secret

# Chatwoot Integration
CHATWOOT_BASE_URL=https://inbox.rnvalves.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_ACCESS_TOKEN=replace_with_chatwoot_admin_bot_access_token
CHATWOOT_INBOX_ID=1
CHATWOOT_WEBHOOK_SECRET=replace_with_chatwoot_webhook_secret

# AI Engine (Gemini / OpenAI API compatible)
AI_PROVIDER=gemini
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
AI_DEFAULT_LANGUAGE=hi
AI_TEMPERATURE=0.2

# Cloudflare R2 Media CDN (Read-Only access to existing assets)
MEDIA_CDN_URL=https://rnvalves.media

# Notification & Escalation Channels (Optional)
ADMIN_ALERT_EMAIL=ecommerce@rnvalves.com
SALES_HEAD_PHONE=+9198XXXXXXXX
